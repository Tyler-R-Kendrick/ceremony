{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "surfaces": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": { "type": "string", "enum": ["browser", "headless"] }
    },
    "configuration": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$" },
          "source": {
            "type": "string",
            "enum": ["session-environment", "host"]
          },
          "classification": {
            "type": "string",
            "enum": ["public", "personal", "secret"]
          },
          "required": { "type": "boolean" }
        },
        "required": ["name", "source", "classification", "required"],
        "additionalProperties": false
      }
    },
    "configurationGroups": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "rule": { "type": "string", "enum": ["all-or-none", "at-least-one"] },
          "names": {
            "minItems": 2,
            "maxItems": 24,
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$" }
          }
        },
        "required": ["id", "rule", "names"],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "configuration",
              "provider-registration",
              "provider-consent"
            ]
          },
          "reuse": { "type": "string", "const": "verified-context" },
          "handoff": {
            "type": "object",
            "properties": {
              "surface": {
                "type": "string",
                "enum": ["provider-browser", "private-collector"]
              },
              "recipient": {
                "type": "string",
                "enum": ["initiating-subject", "authorized-owner"]
              },
              "delegation": { "type": "string", "const": "a2h-authorize" },
              "resume": { "type": "string", "const": "verify" }
            },
            "required": ["surface", "recipient", "delegation", "resume"],
            "additionalProperties": false
          }
        },
        "required": ["id", "kind", "reuse", "handoff"],
        "additionalProperties": false
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["provider-browser", "private-collector"]
        },
        "recipient": {
          "type": "string",
          "enum": ["initiating-subject", "authorized-owner"]
        },
        "delegation": { "type": "string", "const": "a2h-authorize" },
        "resume": { "type": "string", "const": "verify" }
      },
      "required": ["surface", "recipient", "delegation", "resume"],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "verifier": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
        },
        "ownership": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["authenticated", "anonymous", "claimed"]
          }
        }
      },
      "required": ["verifier", "ownership"],
      "additionalProperties": false
    },
    "workflows": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
          },
          "workflowId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          }
        },
        "required": ["document", "version", "workflowId"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "surfaces",
    "configuration",
    "configurationGroups",
    "prerequisites",
    "handoff",
    "completion",
    "workflows"
  ],
  "additionalProperties": false,
  "$id": "urn:ceremony:specification:method-contract-v1",
  "$comment": "Generated from runtime Zod contracts. Structural validation does not replace cross-field checks, registry validation, authentication or provider verification. This identifier is not a fetch endpoint."
}
