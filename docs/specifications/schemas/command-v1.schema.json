{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "runId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$" },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "operationVersion": {
      "type": "string",
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": { "type": "string", "const": "input" },
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
              }
            },
            "required": ["from", "name"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "from": { "type": "string", "const": "output" },
              "node": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
              }
            },
            "required": ["from", "node", "name"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "from": { "type": "string", "const": "literal" },
              "value": {
                "anyOf": [
                  { "type": "string", "maxLength": 512 },
                  { "type": "number" },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["from", "value"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "commandId",
    "runId",
    "nodeId",
    "expectedRevision",
    "operationId",
    "operationVersion",
    "bindings"
  ],
  "additionalProperties": false,
  "$id": "urn:ceremony:specification:command-v1",
  "$comment": "Generated from runtime Zod contracts. Structural validation does not replace cross-field checks, registry validation, authentication or provider verification. This identifier is not a fetch endpoint."
}
