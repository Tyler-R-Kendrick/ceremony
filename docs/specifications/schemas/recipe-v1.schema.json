{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 1000 },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "required": { "type": "boolean" }
        },
        "required": ["contract", "required"],
        "additionalProperties": false
      }
    },
    "invocations": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "use": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "operation" },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                      },
                      {
                        "type": "string",
                        "pattern": "^pack:[a-z][a-z0-9-]{0,39}\\/[a-z][a-z0-9-]{0,47}$"
                      }
                    ]
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
                  }
                },
                "required": ["kind", "id", "version"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "recipe" },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
                  },
                  "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["kind", "id", "version", "digest"],
                "additionalProperties": false
              }
            ]
          },
          "dependsOn": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
            }
          },
          "bindings": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string", "const": "input" },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                    }
                  },
                  "required": ["from", "name"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string", "const": "output" },
                    "node": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                    }
                  },
                  "required": ["from", "node", "name"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string", "const": "literal" },
                    "value": {
                      "anyOf": [
                        { "type": "string", "maxLength": 512 },
                        { "type": "number" },
                        { "type": "boolean" },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["from", "value"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "connector": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "outcome": {
            "type": "object",
            "properties": {
              "successCriteria": {
                "maxItems": 32,
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
              },
              "retry": {
                "type": "object",
                "properties": {
                  "limit": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "afterMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300000
                  },
                  "criteria": {
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  }
                },
                "required": ["limit", "afterMs", "criteria"],
                "additionalProperties": false
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^\\$(?:inputs\\.[A-Za-z0-9_.-]{1,96}|steps\\.[A-Za-z0-9_-]{1,96}\\.outputs\\.[A-Za-z0-9_.-]{1,96})$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string", "const": "input" },
                        "name": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                        }
                      },
                      "required": ["from", "name"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string", "const": "output" },
                        "node": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                        },
                        "name": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
                        }
                      },
                      "required": ["from", "node", "name"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string", "const": "literal" },
                        "value": {
                          "anyOf": [
                            { "type": "string", "maxLength": 512 },
                            { "type": "number" },
                            { "type": "boolean" },
                            { "type": "null" }
                          ]
                        }
                      },
                      "required": ["from", "value"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["successCriteria", "values"],
            "additionalProperties": false
          }
        },
        "required": ["id", "use", "dependsOn", "bindings"],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
          }
        },
        "required": ["node", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "inputs",
    "invocations",
    "outputs"
  ],
  "additionalProperties": false,
  "$id": "urn:ceremony:specification:recipe-v1",
  "$comment": "Generated from runtime Zod contracts. Structural validation does not replace cross-field checks, registry validation, authentication or provider verification. This identifier is not a fetch endpoint."
}
