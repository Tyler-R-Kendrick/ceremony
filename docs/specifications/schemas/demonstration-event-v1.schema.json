{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "eventId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "demonstrationId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "operationVersion": {
      "type": "string",
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
    },
    "actorKind": { "type": "string", "enum": ["human", "agent", "system"] },
    "kind": {
      "type": "string",
      "enum": ["choice", "transition", "handoff", "verification", "failure"]
    },
    "beforeState": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "afterState": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
    },
    "publicBindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$"
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 512 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "verification": {
      "type": "string",
      "enum": ["none", "pending", "accepted", "rejected"]
    },
    "diagnosticCode": {
      "type": "string",
      "enum": [
        "denied",
        "conflict",
        "unavailable",
        "invalid-input",
        "awaiting-human",
        "uncertain",
        "verification-rejected",
        "cancelled",
        "expired"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "demonstrationId",
    "sequence",
    "nodeId",
    "operationId",
    "operationVersion",
    "actorKind",
    "kind",
    "beforeState",
    "afterState",
    "publicBindings",
    "verification"
  ],
  "additionalProperties": false,
  "$id": "urn:ceremony:specification:demonstration-event-v1",
  "$comment": "Generated from runtime Zod contracts. Structural validation does not replace cross-field checks, registry validation, authentication or provider verification. This identifier is not a fetch endpoint."
}
