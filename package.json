{
  "name": "@ceremony/auth",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tyler-R-Kendrick/ceremony.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "overrides": {
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.0"
    },
    "@workflow/world-vercel": {
      "undici": "7.29.0"
    },
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "exports": {
    "./server/teaching": {
      "types": "./dist/server/teaching.d.ts",
      "import": "./dist/server/teaching.js"
    },
    "./mcp-app": {
      "types": "./dist/mcp-app/index.d.ts",
      "import": "./dist/mcp-app/index.js"
    },
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./src/react/styles.css",
    "./teaching.css": "./src/react/teaching.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "src/react/styles.css",
    "src/react/teaching.css",
    "README.md",
    "docs",
    "!docs/implementation-evidence"
  ],
  "scripts": {
    "dev": "node --import tsx examples/server.ts",
    "setup:browsers": "playwright install --with-deps chromium firefox webkit",
    "clean": "node scripts/clean.mjs",
    "clean:apply": "node scripts/clean.mjs --apply",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/build-mcp-app.mjs && node scripts/check-bundle.mjs",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "check:mcp-app": "node scripts/build-mcp-app.mjs --check",
    "test": "node scripts/test.mjs all",
    "test:specs": "node --import tsx --test tests/specifications.test.ts",
    "specs:check": "node --import tsx scripts/specifications.ts",
    "specs:generate": "node --import tsx scripts/specifications.ts --write",
    "test:integration": "node scripts/test.mjs integration",
    "test:security": "node scripts/test.mjs security",
    "test:agent": "node scripts/test.mjs agent",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "verify:live": "node --import tsx scripts/verify-release.ts live",
    "test:live:attended": "node --import tsx scripts/verify-attended.ts",
    "verify:release": "node --import tsx scripts/verify-release.ts release",
    "maintenance:storage": "node --import tsx scripts/persistence-maintenance.ts",
    "build:hosted": "nitro build",
    "build:vercel": "npm run build && nitro build --preset vercel && node scripts/check-hosted-build.mjs",
    "dev:hosted": "nitro dev",
    "test:pact": "node --import tsx --test tests/contracts/*.test.ts",
    "test:scenarios": "node --import tsx --test tests/contracts/auth-scenarios.test.ts tests/browser-driver.test.ts",
    "test:flows": "node --import tsx --test tests/flows/*.flow.ts",
    "flows:gallery": "node scripts/flow-gallery.mjs",
    "build:gallery": "node --import tsx scripts/build-gallery.mjs",
    "test:snapshots": "node --import tsx --test tests/characterization.test.ts",
    "test:snapshots:update": "node --import tsx --test --test-update-snapshots tests/characterization.test.ts",
    "test:fuzz": "node --import tsx --test tests/fuzz.test.ts",
    "test:chaos": "node --import tsx --test tests/chaos.test.ts",
    "test:coverage": "c8 --all --include 'src/**/*.ts' --include 'src/**/*.tsx' --check-coverage --lines 90 --statements 90 --branches 80 --functions 90 --reporter text --reporter json-summary --reports-dir artifacts/coverage node scripts/test.mjs all",
    "test:mutation": "stryker run",
    "test:security:mutation": "stryker run stryker.security.config.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src examples tests scripts package.json tsconfig*.json *.config.ts stryker*.json stryker*.mjs README.md CONTRIBUTING.md PRODUCT.md DESIGN.md docs .devcontainer .github",
    "format:check": "prettier --check src examples tests scripts package.json tsconfig*.json *.config.ts stryker*.json stryker*.mjs README.md CONTRIBUTING.md PRODUCT.md DESIGN.md docs .devcontainer .github",
    "verify": "node --import tsx scripts/verify-deterministic.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.45",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "7.0.95",
    "jose": "^6.1.0",
    "oauth4webapi": "^3.8.0",
    "pg": "8.23.0",
    "playwright-core": "^1.63.0",
    "stripe": "^22.6.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@openuidev/react-lang": "0.2.15",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@workflow/vitest": "4.0.23",
    "agent-browser": "^0.37.1",
    "c8": "12.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.9.0",
    "linkedom": "0.18.13",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.0",
    "workflow": "4.8.7"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "0.2.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "workflow": "4.8.7"
  },
  "peerDependenciesMeta": {
    "@openuidev/react-lang": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ]
}
