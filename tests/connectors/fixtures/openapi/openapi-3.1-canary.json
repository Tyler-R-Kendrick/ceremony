{
  "openapi": "3.1.0",
  "info": {
    "title": "Canary API",
    "version": "1.0.0",
    "description": "A description whose example values embed a credential canary; no projection, diagnostic or export may carry it."
  },
  "servers": [{ "url": "https://canary.example.test" }],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/echo": {
      "post": {
        "operationId": "echo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "CANARY_SECRET_9f3"
                  },
                  "token": { "type": "string", "default": "CANARY_SECRET_9f3" }
                }
              },
              "example": { "message": "CANARY_SECRET_9f3" },
              "examples": {
                "authenticated": {
                  "value": {
                    "message": "CANARY_SECRET_9f3",
                    "token": "CANARY_SECRET_9f3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echoed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                },
                "example": { "message": "CANARY_SECRET_9f3" }
              }
            }
          }
        }
      }
    },
    "/broken": {
      "get": {
        "operationId": "brokenExample",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "style": "spaceDelimited",
            "schema": { "type": "array", "items": { "type": "string" } },
            "example": "CANARY_SECRET_9f3"
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "X-Api-Key",
        "in": "header",
        "description": "Use CANARY_SECRET_9f3 in development."
      }
    },
    "examples": {
      "sample": { "value": { "token": "CANARY_SECRET_9f3" } }
    }
  },
  "x-sample-credentials": { "apiKey": "CANARY_SECRET_9f3" }
}
