# Names only. Supply values through the host's protected environment store.
# Local: npm run dev uses isolated local development, not production identity.
# Hosted: all fields in this first group are required. No anonymous fallback.
CEREMONY_PUBLIC_ORIGIN=
# PostgreSQL URL with sslmode=verify-full; do not disable certificate validation.
CEREMONY_DATABASE_URL=
# 64 hexadecimal characters; keep outside the database and backups.
CEREMONY_VAULT_KEY=
CEREMONY_VAULT_KEY_ID=
CEREMONY_OIDC_ISSUER=
CEREMONY_OIDC_CLIENT_ID=
CEREMONY_OIDC_CLIENT_SECRET=
CEREMONY_TENANT_ID=
CEREMONY_GITHUB_ACCOUNT=
CEREMONY_CONFIGURATION_VERSION=
# Optional shared Jira OAuth app; configure both values together, server-only.
# Register /api/v1/teaching/jira/authorization-return on the exact public origin.
# Rotate CEREMONY_CONFIGURATION_VERSION when changing this shared app.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional fixed Jira site (HTTPS *.atlassian.net origin); otherwise ask the user.
JIRA_SITE_URL=
# Optional previous key ID -> key JSON, max four. Never expose to browser/model.
CEREMONY_VAULT_PREVIOUS_KEYS=
# Optional assistant. URL is the FULL compatible chat/completions endpoint.
# Leaving these unset preserves deterministic Connect/teaching/reuse.
CEREMONY_MODEL_URL=
CEREMONY_MODEL=
CEREMONY_MODEL_KEY=
# Explicit alternative to compatible URL; never enabled by default.
CEREMONY_MODEL_GATEWAY=
# Optional original-task HTTPS consumer, deduplicating deliveryId.
CEREMONY_CONTINUATION_URL=
CEREMONY_CONTINUATION_TOKEN=
# Dedicated scheduled worker bearer token, at least 32 characters.
CRON_SECRET=
# Operator-only maintenance and certification; never enabled implicitly.
CEREMONY_MAINTENANCE_AUTHORIZED=
CEREMONY_LIVE_AUTHORIZED=
