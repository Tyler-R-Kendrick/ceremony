# Names only. Supply values through the host's protected environment store.
# Local: npm run dev uses isolated local development, not production identity.
# Hosted: all fields in this first group are required. No anonymous fallback.
CEREMONY_PUBLIC_ORIGIN=
# PostgreSQL URL with sslmode=verify-full; do not disable certificate validation.
CEREMONY_DATABASE_URL=
# 64 hexadecimal characters; keep outside the database and backups.
CEREMONY_VAULT_KEY=
CEREMONY_VAULT_KEY_ID=
CEREMONY_OIDC_ISSUER=
CEREMONY_OIDC_CLIENT_ID=
CEREMONY_OIDC_CLIENT_SECRET=
CEREMONY_TENANT_ID=
CEREMONY_GITHUB_ACCOUNT=
CEREMONY_CONFIGURATION_VERSION=
# Optional shared Jira OAuth app; configure both values together, server-only.
# Register /api/v1/teaching/jira/authorization-return on the exact public origin.
# Rotate CEREMONY_CONFIGURATION_VERSION when changing this shared app.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional fixed Jira site (HTTPS *.atlassian.net origin); otherwise ask the user.
JIRA_SITE_URL=
# Optional designated OIDC subject for Jira app-setup assignments. Must authenticate with the admin role.
# This shares only app configuration within the configured tenant, target, origin and version; never user consent.
CEREMONY_JIRA_SETUP_OWNER_SUBJECT=
# Optional previous key ID -> key JSON, max four. Never expose to browser/model.
CEREMONY_VAULT_PREVIOUS_KEYS=
# Optional isolated-browser remote sessions. Any remote browser (Browserbase,
# Cloudflare, or a CDP endpoint) is refused unless the egress proxy below is
# also set: a remote browser's traffic cannot pass through the local proxy.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Any Chrome DevTools Protocol websocket (Steel, browserless, self-hosted).
# wss:// anywhere, ws:// only on loopback; no userinfo in the URL.
CEREMONY_BROWSER_CDP_URL=
# Optional JSON object of headers for the CDP upgrade, e.g. {"Authorization":"Bearer ..."}.
CEREMONY_BROWSER_CDP_HEADERS=
# Required for any remote browser: http(s):// proxy the remote browser can reach,
# vetted by the operator to contain egress. Credentials go in their own fields.
CEREMONY_BROWSER_REMOTE_PROXY=
CEREMONY_BROWSER_REMOTE_PROXY_USERNAME=
CEREMONY_BROWSER_REMOTE_PROXY_PASSWORD=
# Optional agent inbox override for unattended account registration. The host
# POSTs /addresses for a fresh address and GETs /messages?to&since for
# verification mail; the token stays server-side and never enters chat or
# model context. Unset: the example server uses the public mail.tm API.
CEREMONY_INBOX_URL=
CEREMONY_INBOX_TOKEN=
# Optional assistant. URL is the FULL compatible chat/completions endpoint.
# Leaving these unset preserves deterministic Connect/teaching/reuse.
CEREMONY_MODEL_URL=
CEREMONY_MODEL=
CEREMONY_MODEL_KEY=
# Explicit alternative to compatible URL; never enabled by default.
CEREMONY_MODEL_GATEWAY=
# Optional original-task HTTPS consumer, deduplicating deliveryId.
CEREMONY_CONTINUATION_URL=
CEREMONY_CONTINUATION_TOKEN=
# Dedicated scheduled worker bearer token, at least 32 characters.
CRON_SECRET=
# Operator-only maintenance and certification; never enabled implicitly.
CEREMONY_MAINTENANCE_AUTHORIZED=
CEREMONY_LIVE_AUTHORIZED=
# Optional Agent2Human gateway for Jira owner notification. All seven values required together.
# Recipients is JSON {"<oidc-subject>":{"principalId":"...","type":"email","address":"mailto:..."}}.
CEREMONY_A2H_GATEWAY_ORIGIN=
CEREMONY_A2H_AGENT_ID=
CEREMONY_A2H_KEY_ID=
CEREMONY_A2H_PRIVATE_JWK=
CEREMONY_A2H_GATEWAY_JWK=
CEREMONY_A2H_API_KEY=
CEREMONY_A2H_RECIPIENTS=
